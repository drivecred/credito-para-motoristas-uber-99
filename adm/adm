<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MotoFácil ADM - Dashboard Pro</title>
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <style>
    :root {
      --bg-body: #080b11;
      --card-bg: #111723;
      --card-border: #1e293b;
      --accent-yellow: #f59e0b;
      --accent-green: #10b981;
      --accent-red: #ef4444;
      --accent-blue: #3b82f6;
      --text-main: #f8fafc;
      --text-sub: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: system-ui, -apple-system, sans-serif;
    }

    body {
      background-color: var(--bg-body);
      color: var(--text-main);
      padding: 12px;
      display: flex;
      justify-content: center;
    }

    .admin-container {
      width: 100%;
      max-width: 600px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    /* HEADER */
    header {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      padding: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .brand i { font-size: 1.6rem; color: var(--accent-yellow); }
    .brand h1 { font-size: 1.1rem; font-weight: 800; }
    .brand h1 span { color: var(--accent-yellow); }

    .btn-novo {
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
      color: #000;
      border: none;
      padding: 8px 14px;
      border-radius: 10px;
      font-weight: 800;
      font-size: 0.8rem;
      display: flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
    }

    /* MÉTRICAS */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .metric-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 12px;
    }

    .metric-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.75rem;
      color: var(--text-sub);
    }

    .metric-icon {
      width: 28px;
      height: 28px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .yellow { background: rgba(245, 158, 11, 0.15); color: var(--accent-yellow); }
    .green { background: rgba(16, 185, 129, 0.15); color: var(--accent-green); }
    .red { background: rgba(239, 68, 68, 0.15); color: var(--accent-red); }
    .blue { background: rgba(59, 130, 246, 0.15); color: var(--accent-blue); }

    .metric-value { font-size: 1.1rem; font-weight: 800; margin-top: 4px; }

    /* SEÇÃO DE LOCATÁRIOS */
    .section-title {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--accent-yellow);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* CARD DE LOCATÁRIO COMPLETO E PRECISO */
    .locatario-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .card-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }

    .card-head h3 { font-size: 1rem; font-weight: 800; }
    .card-head p { font-size: 0.75rem; color: var(--text-sub); }

    .badge-status {
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 0.7rem;
      font-weight: 800;
    }

    .badge-status.ok { background: rgba(16, 185, 129, 0.15); color: var(--accent-green); border: 1px solid rgba(16, 185, 129, 0.3); }

    /* GRID DE DADOS PRECISOS */
    .data-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      background: rgba(0, 0, 0, 0.25);
      border: 1px solid rgba(255, 255, 255, 0.05);
      padding: 12px;
      border-radius: 12px;
    }

    .data-item span {
      font-size: 0.68rem;
      color: var(--text-sub);
      display: block;
      margin-bottom: 2px;
    }

    .data-item strong {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--text-main);
    }

    /* BOTÕES DE AÇÃO DO CARD */
    .card-actions {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }

    .btn-card {
      padding: 10px 6px;
      background: #1a2332;
      border: 1px solid var(--card-border);
      color: #fff;
      border-radius: 10px;
      font-size: 0.75rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: all 0.2s;
    }

    .btn-card:hover {
      border-color: var(--accent-yellow);
      background: #232d3f;
    }

    .btn-card i { font-size: 1rem; color: var(--accent-yellow); }

    /* POP-UPS E MODAIS CUSTOMIZADOS */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(6px);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 1000;
      padding: 14px;
    }

    .modal-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 18px;
      width: 100%;
      max-width: 480px;
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--card-border);
      padding-bottom: 10px;
    }

    .modal-header h3 {
      font-size: 1rem;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .close-icon {
      cursor: pointer;
      font-size: 1.3rem;
      color: var(--text-sub);
    }

    .close-icon:hover { color: #fff; }

    /* CONTEÚDO DO POP-UP DE FINANCEIRO */
    .table-payments {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.75rem;
    }

    .table-payments th, .table-payments td {
      padding: 8px;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .table-payments th { color: var(--text-sub); font-size: 0.7rem; }

    /* CONTEÚDO DO POP-UP DE MANUTENÇÃO */
    .oil-bar-container {
      background: rgba(0, 0, 0, 0.3);
      padding: 12px;
      border-radius: 10px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .progress-track {
      width: 100%;
      height: 10px;
      background: #1e293b;
      border-radius: 10px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      width: 60%;
      background: linear-gradient(90deg, var(--accent-green), var(--accent-yellow));
    }

    .ocr-box {
      border: 1px dashed var(--card-border);
      border-radius: 12px;
      padding: 12px;
      text-align: center;
      background: rgba(255, 255, 255, 0.02);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
    }

    .ocr-box img {
      width: 100%;
      max-height: 150px;
      object-fit: cover;
      border-radius: 8px;
    }

    /* CONTEÚDO DO POP-UP DE EDIÇÃO */
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-group label {
      font-size: 0.75rem;
      color: var(--text-sub);
    }

    .form-group input, .form-group select {
      background: #0d121d;
      border: 1px solid var(--card-border);
      padding: 10px;
      border-radius: 8px;
      color: #fff;
      font-size: 0.85rem;
    }

    .btn-save {
      background: var(--accent-yellow);
      color: #000;
      border: none;
      padding: 12px;
      border-radius: 10px;
      font-weight: 800;
      cursor: pointer;
      margin-top: 8px;
    }
  </style>
</head>
<body>

  <div class="admin-container">
    <!-- HEADER -->
    <header>
      <div class="brand">
        <i class="ph ph-shield-check"></i>
        <h1>Moto<span>Fácil</span> ADM</h1>
      </div>
      <button class="btn-novo">
        <i class="ph ph-user-plus"></i> Novo Locatário
      </button>
    </header>

    <!-- MÉTRICAS -->
    <div class="metrics-grid">
      <div class="metric-card">
        <div class="metric-header"><span>Frota Alugada</span><div class="metric-icon yellow"><i class="ph ph-motorbike"></i></div></div>
        <div class="metric-value">8 / 10</div>
      </div>
      <div class="metric-card">
        <div class="metric-header"><span>Receita Semanal</span><div class="metric-icon green"><i class="ph ph-currency-circle-dollar"></i></div></div>
        <div class="metric-value">R$ 2.560</div>
      </div>
      <div class="metric-card">
        <div class="metric-header"><span>Inadimplentes</span><div class="metric-icon red"><i class="ph ph-warning-circle"></i></div></div>
        <div class="metric-value">1 Client.</div>
      </div>
      <div class="metric-card">
        <div class="metric-header"><span>Trocas de Óleo</span><div class="metric-icon blue"><i class="ph ph-wrench"></i></div></div>
        <div class="metric-value">2 Alertas</div>
      </div>
    </div>

    <div class="section-title">
      <i class="ph ph-users-three"></i> Locatários e Contratos Ativos
    </div>

    <!-- CARD COMPLETO DO LOCATÁRIO -->
    <div class="locatario-card">
      <div class="card-head">
        <div>
          <h3>Carlos Eduardo Silva</h3>
          <p>HONDA CG 160 START • PTM-3F56</p>
        </div>
        <span class="badge-status ok">Em Dia</span>
      </div>

      <!-- DADOS PRECISOS EXIBIDOS DIRETO NO CARD -->
      <div class="data-grid">
        <div class="data-item">
          <span>Semana Vigente</span>
          <strong>Semana 1 / 12</strong>
        </div>
        <div class="data-item">
          <span>Próx. Vencimento</span>
          <strong>30/09/2026 (R$ 320)</strong>
        </div>
        <div class="data-item">
          <span>Hodômetro (OCR / Manual)</span>
          <strong>175.925 km</strong>
        </div>
        <div class="data-item">
          <span>Próx. Troca Óleo</span>
          <strong>176.325 km (Faltam 400km)</strong>
        </div>
        <div class="data-item">
          <span>Caução Retida</span>
          <strong>R$ 700,00 (Dev. 15/01/27)</strong>
        </div>
        <div class="data-item">
          <span>Atraso / Multa</span>
          <strong>0 dias (R$ 0,00)</strong>
        </div>
      </div>

      <!-- BOTÕES COM POP-UPS EXCLUSIVOS -->
      <div class="card-actions">
        <button class="btn-card" onclick="abrirModal('modalFinanceiro')">
          <i class="ph ph-receipt"></i> Pagamentos
        </button>
        <button class="btn-card" onclick="abrirModal('modalManutencao')">
          <i class="ph ph-wrench"></i> Manutenção
        </button>
        <button class="btn-card" onclick="abrirModal('modalEditar')">
          <i class="ph ph-pencil-simple"></i> Editar
        </button>
      </div>
    </div>
  </div>

  <!-- POP-UP 1: HISTÓRICO FINANCEIRO (SEM ALERT NATIVO) -->
  <div class="modal-overlay" id="modalFinanceiro">
    <div class="modal-card">
      <div class="modal-header">
        <h3><i class="ph ph-receipt" style="color: var(--accent-yellow);"></i> Detalhes Financeiros</h3>
        <i class="ph ph-x close-icon" onclick="fecharModal('modalFinanceiro')"></i>
      </div>
      <p style="font-size: 0.75rem; color: var(--text-sub);">Carlos Eduardo Silva • PTM-3F56</p>

      <table class="table-payments">
        <thead>
          <tr>
            <th>Semana</th>
            <th>Vencimento</th>
            <th>Valor</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Semana 1</td>
            <td>30/09/2026</td>
            <td>R$ 320,00</td>
            <td><span class="badge-status ok">Pago</span></td>
          </tr>
          <tr>
            <td>Semana 2</td>
            <td>07/10/2026</td>
            <td>R$ 320,00</td>
            <td><span style="color: var(--accent-yellow);">Pendente</span></td>
          </tr>
          <tr>
            <td>Semana 3</td>
            <td>14/10/2026</td>
            <td>R$ 320,00</td>
            <td><span style="color: var(--text-sub);">A Vencer</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- POP-UP 2: MANUTENÇÃO E ÓLEO (SEM ALERT NATIVO) -->
  <div class="modal-overlay" id="modalManutencao">
    <div class="modal-card">
      <div class="modal-header">
        <h3><i class="ph ph-wrench" style="color: var(--accent-yellow);"></i> Detalhes da Manutenção</h3>
        <i class="ph ph-x close-icon" onclick="fecharModal('modalManutencao')"></i>
      </div>

      <div class="oil-bar-container">
        <div style="display: flex; justify-content: space-between; font-size: 0.75rem;">
          <span>Ciclo do Óleo (1.000 KM)</span>
          <strong style="color: var(--accent-yellow);">600 / 1.000 KM</strong>
        </div>
        <div class="progress-track">
          <div class="progress-fill"></div>
        </div>
        <span style="font-size: 0.7rem; color: var(--text-sub);">Faltam 400 KM para o limite de 176.325 km</span>
      </div>

      <div class="ocr-box">
        <span style="font-size: 0.75rem; color: var(--text-sub);">Foto enviada do Painel:</span>
        <img src="https://images.unsplash.com/photo-1558981806-ec527fa84c39?w=400&auto=format&fit=crop&q=60" alt="Painel Moto">
        <span style="font-size: 0.8rem; font-weight: 700; color: var(--accent-green);">Validação OCR: 175.925 KM</span>
      </div>
    </div>
  </div>

  <!-- POP-UP 3: EDITAR CONTRATO E DADOS (SEM ALERT NATIVO) -->
  <div class="modal-overlay" id="modalEditar">
    <div class="modal-card">
      <div class="modal-header">
        <h3><i class="ph ph-pencil-simple" style="color: var(--accent-yellow);"></i> Editar Dados da Locação</h3>
        <i class="ph ph-x close-icon" onclick="fecharModal('modalEditar')"></i>
      </div>

      <div class="form-group">
        <label>Nome do Locatário</label>
        <input type="text" value="Carlos Eduardo Silva">
      </div>

      <div class="form-group">
        <label>Veículo e Placa</label>
        <input type="text" value="HONDA CG 160 START • PTM-3F56">
      </div>

      <div class="form-group">
        <label>Valor Semanal (R$)</label>
        <input type="text" value="320,00">
      </div>

      <button class="btn-save" onclick="fecharModal('modalEditar')">Salvar Alterações</button>
    </div>
  </div>

  <script>
    function abrirModal(id) {
      document.getElementById(id).style.display = 'flex';
    }

    function fecharModal(id) {
      document.getElementById(id).style.display = 'none';
    }
  </script>
</body>
</html>
